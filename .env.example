# Outpost configuration. Copy to .env and edit. Every line is optional; the values
# shown are the defaults.

# ── Who can reach Outpost ────────────────────────────────────────────────────
# By default only this computer can open Outpost. To use it from phones and other
# computers on your network, set BOTH of these, then restart:
#   OUTPOST_LAN_ACCESS=true
#   OUTPOST_BIND=0.0.0.0
# Outpost has no accounts or sign-in. With LAN access on, everyone on your network can
# read, add, change and delete what is in it, so turn it on only for a network you
# trust (your home), and never forward the port to the internet.
OUTPOST_LAN_ACCESS=false
OUTPOST_BIND=127.0.0.1
OUTPOST_PORT=8080

# Extra host names Outpost should answer to, comma separated (for example a name you
# gave it on your router, or the host name used by a reverse proxy).
OUTPOST_ALLOWED_HOSTS=

# ── Limits ───────────────────────────────────────────────────────────────────
# Largest single upload, in megabytes.
OUTPOST_MAX_UPLOAD_MB=2048
# Memory ceilings for the two containers. Raise OUTPOST_MEMORY_LIMIT if you index
# very large PDFs or turn on semantic search.
OUTPOST_MEMORY_LIMIT=1g
KIWIX_MEMORY_LIMIT=512m

# ── Downloads ────────────────────────────────────────────────────────────────
# Downloads are only allowed from hosts named in the catalogue manifests. Add your
# own mirror here (comma separated). To allow a mirror on your own network (a private
# address), also set OUTPOST_ALLOW_PRIVATE_DOWNLOADS=true.
OUTPOST_DOWNLOAD_HOSTS=
OUTPOST_ALLOW_PRIVATE_DOWNLOADS=false

# ── Clean-up ─────────────────────────────────────────────────────────────────
# "Erase everything" (Storage → Manage and clean up) deletes notes and documents, so
# it can only be started on this computer. Set this to true to allow it from every
# device that can reach Outpost. With OUTPOST_LAN_ACCESS=true in Docker, nothing looks
# local to the container, so this is the only way to erase from the browser.
OUTPOST_ALLOW_REMOTE_ERASE=false

# Answers from your library are written by a model server you run. By default it must
# be on this computer or a private network. Set this only if yours is reached over the
# internet: the question and passages from your library are sent to it.
OUTPOST_ALLOW_REMOTE_MODEL_SERVER=false

# ── Image ────────────────────────────────────────────────────────────────────
# The name given to the image that `docker compose up -d --build` builds on this machine.
# OUTPOST_IMAGE=outpost:local

# ── Running without Docker (pnpm start, or the packaged app) ─────────────────
# OUTPOST_HOST=127.0.0.1
# OUTPOST_DATA_DIR=./data
# Folders Outpost may use for content, comma separated. Storage locations can only
# be created inside these.
# OUTPOST_STORAGE_ROOTS=/srv/outpost,/mnt/nas/outpost
# Reference collections need kiwix-serve. Point at a binary and Outpost runs it, or
# at a server you run yourself.
# OUTPOST_KIWIX_BIN=/usr/local/bin/kiwix-serve
# OUTPOST_KIWIX_URL=http://127.0.0.1:8081
