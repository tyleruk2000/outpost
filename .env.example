# Outpost configuration. Copy to .env and edit. Every line is optional; the values
# shown are the defaults.

# ── Who can reach Outpost ────────────────────────────────────────────────────
# By default only this computer can open Outpost. To use it from phones and other
# computers on your network, set BOTH of these, then restart:
#   OUTPOST_LAN_ACCESS=true
#   OUTPOST_BIND=0.0.0.0
# Outpost has no accounts or sign-in. With LAN access on, everyone on your network can
# read, add, change and delete what is in it, so turn it on only for a network you
# trust (your home), and never forward the port to the internet.
OUTPOST_LAN_ACCESS=false
OUTPOST_BIND=127.0.0.1
OUTPOST_PORT=8080

# Extra host names Outpost should answer to, comma separated (for example a name you
# gave it on your router, or the host name used by a reverse proxy).
OUTPOST_ALLOWED_HOSTS=

# ── HTTPS on your network ────────────────────────────────────────────────────
# HTTPS is turned on in Settings, not here. This is only the port it uses. In Docker,
# also uncomment the HTTPS line under "ports" in compose.yaml so the port is published.
OUTPOST_HTTPS_PORT=8443

# ── Limits ───────────────────────────────────────────────────────────────────
# Largest single upload, in megabytes.
OUTPOST_MAX_UPLOAD_MB=2048
# Memory ceilings for the two containers. Raise OUTPOST_MEMORY_LIMIT if you index
# very large PDFs or turn on semantic search.
OUTPOST_MEMORY_LIMIT=1g
KIWIX_MEMORY_LIMIT=512m

# ── Downloads ────────────────────────────────────────────────────────────────
# Downloads are only allowed from hosts named in the catalogue manifests. Add your
# own mirror here (comma separated). To allow a mirror on your own network (a private
# address), also set OUTPOST_ALLOW_PRIVATE_DOWNLOADS=true.
OUTPOST_DOWNLOAD_HOSTS=
OUTPOST_ALLOW_PRIVATE_DOWNLOADS=false

# ── Clean-up ─────────────────────────────────────────────────────────────────
# "Erase everything" (Storage → Manage and clean up) deletes notes and documents, so
# it can only be started on this computer. Set this to true to allow it from every
# device that can reach Outpost. With OUTPOST_LAN_ACCESS=true in Docker, nothing looks
# local to the container, so this is the only way to erase from the browser.
OUTPOST_ALLOW_REMOTE_ERASE=false

# The settings that open a port or a device on this computer, or let other programs read
# what Outpost holds (Settings → Mesh radio, and the switch that lets other programs use
# Outpost's tools), can only be changed on this computer. Set this to true to allow it
# from every device that can reach Outpost. In Docker, nothing looks local to the
# container, so this is the only way to change them from a browser. After changing
# it, run `sudo docker compose up -d` (or restart Outpost).
OUTPOST_ALLOW_REMOTE_SETTINGS=false

# Answers from your library are written by a model server you run. By default it must
# be on this computer or a private network. Set this only if yours is reached over the
# internet: the question and passages from your library are sent to it.
OUTPOST_ALLOW_REMOTE_MODEL_SERVER=false

# ── The device ───────────────────────────────────────────────────────────────
# The server's time zone. It decides when scheduled backups run, the times in the event
# log's Markdown export, the dates in text the server writes (a chat kept as a note, the
# notes of a merge), where a learner's day and week begin, and the zone Server status
# names. Backup file names and the server's logs stay in UTC whatever it is. A container
# has no zone of its own and uses UTC unless this is set; deploy/pi/install.sh sets it to
# the Pi's zone when there is no TZ line here, and leaves one you wrote alone.
# TZ=Europe/London
# Outpost notices when the server's clock is more than a minute from the browser's and
# offers to set it. Only a browser on this computer may, unless this is true. In Docker
# the clock can be set only through the small service deploy/pi/install.sh adds on a
# Raspberry Pi (see docs/device.md).
OUTPOST_ALLOW_REMOTE_CLOCK=false
# Outpost's figures for Prometheus at /metrics, for this computer and the local network
# only. See deploy/pi/monitoring.md.
OUTPOST_METRICS=false

# Where "Look for Ollama on this computer" looks, after the address in Settings. Leave it
# out for the usual port (11434). Comma-separated addresses, each ending in /v1.
# OUTPOST_OLLAMA_ADDRESSES=http://127.0.0.1:11500/v1

# ── Streets for routes (optional) ────────────────────────────────────────────
# Door-to-door directions, walking, cycling and reachable areas, from Valhalla running
# beside Outpost. Off unless you turn it on here (or with deploy/pi/install.sh
# --street-routes). Then build streets for a country from Offline maps → Map data: on a
# Raspberry Pi 5 (8 GB) Great Britain takes about an hour, needs about 8 GB of free disk
# while it builds, 2.7 GB afterwards, and writes about 50 GB to the disk (an SD card wears
# with writes; a USB SSD is better if you rebuild often). In use it holds about 0.7 GB of
# memory, plus tile data the system can drop when short.
# COMPOSE_PROFILES=routes
# Threads a build uses (two kept a Pi 5 responsive), and threads answering requests.
VALHALLA_BUILD_THREADS=2
VALHALLA_SERVE_THREADS=2
# A build stops if the computer has less memory left than this (MB).
VALHALLA_MIN_AVAILABLE_MB=800
# Memory ceiling for the streets container (a Great Britain build used about 2.3 GB).
VALHALLA_MEMORY_LIMIT=3g
# The user and group Outpost runs as, given the streets' shared folder so that it can leave
# its requests there. Change only if you run Outpost's container as another user.
# OUTPOST_UID=1000
# OUTPOST_GID=1000

# ── Image ────────────────────────────────────────────────────────────────────
# The name given to the image that `docker compose up -d --build` builds on this machine.
# OUTPOST_IMAGE=outpost:local

# ── Running without Docker (pnpm start, or the packaged app) ─────────────────
# OUTPOST_HOST=127.0.0.1
# OUTPOST_DATA_DIR=./data
# Folders Outpost may use for content, comma separated. Storage locations can only
# be created inside these.
# OUTPOST_STORAGE_ROOTS=/srv/outpost,/mnt/nas/outpost
# Reference collections need kiwix-serve. Point at a binary and Outpost runs it, or
# at a server you run yourself.
# OUTPOST_KIWIX_BIN=/usr/local/bin/kiwix-serve
# OUTPOST_KIWIX_URL=http://127.0.0.1:8081
