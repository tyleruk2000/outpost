node_modules/
dist/
coverage/
.env
.env.local
*.log
.DS_Store

# Runtime data. Never commit a library.
/data/
/storage/
apps/server/data/
*.part

# Test output
e2e/test-results/
e2e/playwright-report/
e2e/.tmp/
.tmp/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Local tooling
.impeccable/

# Map fonts and sprites are fetched at build time (scripts/fetch-map-assets.mjs)
apps/web/public/map-assets/

# Editor and agent tooling written per machine (absolute paths inside)
.cursor/

# The search-by-meaning model is fetched at build time (scripts/fetch-embedding-model.mjs)
apps/server/models/

# Temporary files the tracker writes while exporting
.beads/.~*

# A local Compose override (for example the HTTPS port published by deploy/pi/install.sh --https)
compose.override.yaml

# The ITU's P.533 software is built on each computer and never committed
# (scripts/build-p533-engine.mjs; docs/hf-propagation.md, "Licences and attribution")
engines/p533/.upstream/
engines/p533/.build-*/
engines/p533/.cache/
engines/p533/engine/
