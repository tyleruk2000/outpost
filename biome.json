{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/migrations/meta",
      "!apps/web/public",
      "!.beads",
      "!.claude",
      "!**/*.gen.ts",
      "!catalog/schema",
      "!engines/solar/predicted-solar-cycle.json",
      "!apps/server/src/modules/supplies/foods/fdc-sr-legacy.json",
      "!apps/server/src/modules/tides/data/noaa-harmonic.json",
      "!apps/server/src/modules/tides/data/ticon4-harmonic.json",
      "!apps/server/test/fixtures/tides",
      "!apps/server/test/fixtures/sky",
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "warn" },
      "a11y": { "preset": "recommended" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } }
}
