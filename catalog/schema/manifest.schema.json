{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "downloadHosts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "enum": [
              "survival",
              "medicine",
              "food",
              "agriculture",
              "engineering",
              "repair",
              "radio",
              "navigation",
              "preparedness",
              "encyclopedias",
              "science",
              "reference",
              "maps"
            ]
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "format": {
            "type": "string",
            "enum": [
              "zim",
              "pdf",
              "epub",
              "html",
              "other"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "licenseNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "homepage": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https:\\/\\/[^\\s]+$"
          },
          "lastVerified": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "tags": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "sizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "kiwix"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[^\\s/?#&]+$"
                  },
                  "flavour": {
                    "type": "string",
                    "maxLength": 50,
                    "pattern": "^[a-z0-9_-]*$"
                  }
                },
                "required": [
                  "type",
                  "name",
                  "flavour"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "http"
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^https:\\/\\/[^\\s]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "sizeBytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "published": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "category",
          "publisher",
          "language",
          "format",
          "license",
          "attribution",
          "lastVerified",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "maintainers",
    "downloadHosts",
    "entries"
  ],
  "additionalProperties": false,
  "title": "Outpost catalogue manifest",
  "description": "A list of content Outpost can download, with where each item comes from. See catalog/README.md."
}
